<Window x:Class="SkladUchet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#F4F6F8" 
        Title="Склад: учёт сроков годности" Height="720" Width="1150"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,16">
            <materialDesign:PackIcon Kind="Warehouse" Width="32" Height="32" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="Управление складом" FontSize="26" FontWeight="SemiBold" Foreground="#37474F" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" Padding="16" Margin="8,0,8,16" CornerRadius="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="#FF8F00" Width="22" Height="22" Margin="0,0,8,0"/>
                    <TextBlock Text="Внимание! Истекают сроки годности" FontWeight="Bold" Foreground="#EF6C00" FontSize="15"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="30,2,0,0" FontSize="14" Foreground="#424242">
                                <Run Text="{Binding Product.Name}" FontWeight="SemiBold"/>
                                <Run Text=" — партия "/>
                                <Run Text="{Binding BatchNumber}"/>
                                <Run Text=" до "/>
                                <Run Text="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}"/>
                                <Run Text=" [" Foreground="#EF6C00"/>
                                <Run Text="{Binding Status}" Foreground="#EF6C00" FontWeight="Bold"/>
                                <Run Text="]" Foreground="#EF6C00"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="8,0,8,16" materialDesign:ElevationAssist.Elevation="Dp2">
            <TabControl Background="Transparent" BorderThickness="0" Margin="8">
                <TabItem Header="ПАРТИИ ТОВАРОВ" Foreground="#546E7A" FontWeight="SemiBold">
                    <DataGrid ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0" 
                              RowBackground="White" AlternatingRowBackground="#FAFAFA"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" materialDesign:DataGridAssist.CellPadding="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="*"/>
                            <DataGridTextColumn Header="Партия" Binding="{Binding BatchNumber}" Width="120"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding Remaining}" Width="100"/>
                            <DataGridTextColumn Header="Годен до" Binding="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="ИСТОРИЯ СПИСАНИЙ" Foreground="#546E7A" FontWeight="SemiBold">
                    <DataGrid ItemsSource="{Binding WriteOffs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0" 
                              RowBackground="White" AlternatingRowBackground="#FAFAFA"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" materialDesign:DataGridAssist.CellPadding="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Партия" Binding="{Binding Batch.BatchNumber}" Width="120"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,0,8,0">
            <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="#78909C" BorderBrush="#78909C" Margin="0,0,12,0" Height="40" Padding="16,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Обновить" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button Click="BtnAdd_Click" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="#81C784" BorderBrush="#81C784" Margin="0,0,12,0" Height="40" Padding="16,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlusBox" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Принять партию" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding WriteOffCommand}" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="#E57373" BorderBrush="#E57373" Margin="0,0,20,0" Height="40" Padding="16,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Списать" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#757575" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="SkladUchet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад: учёт сроков годности"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление складом"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="#FFF4E5" BorderBrush="#FFB74D"
                BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="⚠ Уведомления о сроках годности"
                           FontWeight="Bold" Foreground="#E65100"/>
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Product.Name}"/>
                                <Run Text=" — партия "/>
                                <Run Text="{Binding BatchNumber}"/>
                                <Run Text=" до "/>
                                <Run Text="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}"/>
                                <Run Text=" ["/>
                                <Run Text="{Binding Status}"/>
                                <Run Text="]"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Batches}"
                  SelectedItem="{Binding SelectedBatch}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар"    Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Партия"   Binding="{Binding BatchNumber}" Width="100"/>
                <DataGridTextColumn Header="Остаток"  Binding="{Binding Remaining}" Width="80"/>
                <DataGridTextColumn Header="Годен до" Binding="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Статус"   Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Обновить" Command="{Binding RefreshCommand}"
                    Width="120" Height="32" Margin="0,0,8,0"/>
            <Button Content="Списать"  Command="{Binding WriteOffCommand}"
                    Width="120" Height="32" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       Margin="16,0,0,0" Foreground="#555"/>
        </StackPanel>
    </Grid>
</Window>